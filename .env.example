# Turso Database Configuration
# Get these from your Turso dashboard
TURSO_DATABASE_URL=libsql://your-db-url.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# AI Configuration (Vercel AI SDK)
OPENAI_API_KEY=sk-your-openai-api-key

# Security
AUTH_SECRET=generate-a-strong-random-secret-here
KITCHEN_PIN=1234

# Google Sheets ETL Integration
# 1. Create a Service Account in GCP Console
# 2. Download the JSON key
# 3. Encode it: cat service-account.json | base64
# 4. Paste the base64 string below
GOOGLE_SHEETS_CREDENTIALS_B64=your-base64-encoded-service-account-json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-url
